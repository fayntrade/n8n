        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  template_id: $('⚙️ НАСТРОЙКИ — заполните').first().json.creatomate_template_id,\n  modifications: {\n    'Hook.text': $json.hook,\n    'Subtitle.text': $json.subtitle,\n    'CTA.text': $json.cta\n  }\n}) }}",
        "options": {}
      },
