          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000017",
      "name": "⚙️ НАСТРОЙКИ — заполните",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: $json.claude_model,\n  max_tokens: 800,\n  messages: [{\n    role: 'user',\n    content: 'Ты SMM-маркетолог салона красоты \"' + $json.salon_name + '\" (' + $json.city + '). ' +\n      'Напиши сценарий вертикального Reels на 15 секунд по формуле: игра в директе + бот + гарантированный приз. ' +\n      'Кодовое слово: ' + $json.keyword + '. Призы: ' + $json.prize_a + ' или ' + $json.prize_b + '. ' +\n      'Каждый день придумывай новый хук, не повторяйся. Сегодня ' + $now.toFormat('dd.MM.yyyy') + '. ' +\n      'Ответь ТОЛЬКО JSON без пояснений: {\"hook\": \"хук до 6 слов\", \"subtitle\": \"механика до 12 слов\", ' +\n      '\"cta\": \"призыв с кодовым словом до 8 слов\", \"caption\": \"подпись к посту до 300 символов с эмодзи и 5 хэштегами\"}'\n  }]\n}) }}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        }
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000018",
      "name": "Сценарий от Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Claude returns text; extract the JSON object from it\nconst text = ($json.content ?? []).map((c) => c.text ?? '').join('');\nconst start = text.indexOf('{');\nconst end = text.lastIndexOf('}');\nif (start === -1 || end === -1) throw new Error('Claude did not return JSON: ' + text);\nconst script = JSON.parse(text.slice(start, end + 1));\nfor (const key of ['hook', 'subtitle', 'cta', 'caption']) {\n  if (!script[key]) throw new Error('Missing field in script: ' + key);\n}\nreturn [{ json: script }];"
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000019",
      "name": "Разобрать сценарий",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
