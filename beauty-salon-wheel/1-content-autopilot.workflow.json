{
  "name": "Салон: автопостинг Reels «Колесо фортуны»",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 11
            }
          ]
        }
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000016",
      "name": "Каждый день в 11:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1b2c3d4-0000-4000-8000-000000000001",
