              "id": "a1b2c3d4-0000-4000-8000-000000000003",
              "name": "keyword",
              "value": "КОЛЕСО",
              "type": "string"
            },
            {
              "id": "a1b2c3d4-0000-4000-8000-000000000004",
              "name": "prize_a",
              "value": "скидка 50%",
              "type": "string"
            },
            {
              "id": "a1b2c3d4-0000-4000-8000-000000000005",
              "name": "prize_b",
              "value": "бесплатный уход за кожей",
              "type": "string"
            },
            {
              "id": "a1b2c3d4-0000-4000-8000-000000000006",
              "name": "creatomate_template_id",
              "value": "ВСТАВЬТЕ_ID_ШАБЛОНА_CREATOMATE",
              "type": "string"
            },
            {
              "id": "a1b2c3d4-0000-4000-8000-000000000007",
              "name": "ig_user_id",
              "value": "ВСТАВЬТЕ_INSTAGRAM_USER_ID",
              "type": "string"
            },
