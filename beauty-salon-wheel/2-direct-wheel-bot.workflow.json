    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Weighted prizes: the sum of weights is 100\nconst PRIZES = [\n  { title: 'скидка 20% на любую услугу', weight: 40 },\n  { title: 'скидка 30% на маникюр или педикюр', weight: 30 },\n  { title: 'скидка 50% на любую процедуру', weight: 25 },\n  { title: 'бесплатный уход за кожей лица', weight: 5 },\n];\n\n// Static data persists only in production executions (active workflow)\nconst store = $getWorkflowStaticData('global');\nstore.spins ??= {};\nconst senderId = $json.sender_id;\nconst previous = store.spins[senderId];\nif (previous) {\n  return { json: { ...$json, already: true, prize: previous.prize, code: previous.code } };\n}\n\nlet roll = Math.random() * PRIZES.reduce((sum, p) => sum + p.weight, 0);\nconst prize = PRIZES.find((p) => (roll -= p.weight) < 0) ?? PRIZES[0];\nconst code = 'WHEEL-' + Math.random().toString(36).slice(2, 7).toUpperCase();\nstore.spins[senderId] = { prize: prize.title, code, at: new Date().toISOString(), booked: false };\n\nreturn { json: { ...$json, already: false, prize: prize.title, code } };"
      },
