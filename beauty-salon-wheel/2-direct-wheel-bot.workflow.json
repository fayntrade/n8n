    {
      "parameters": {
        "jsCode": "// Instagram sends a batch: entry[] -> messaging[]\nconst keyword = $('⚙️ НАСТРОЙКИ — заполните').first().json.keyword.toUpperCase();\nconst results = [];\nfor (const item of $input.all()) {\n  const body = item.json.body ?? {};\n  for (const entry of body.entry ?? []) {\n    for (const event of entry.messaging ?? []) {\n      const message = event.message;\n      // Skip our own outgoing messages and non-text events\n      if (!message || message.is_echo) continue;\n      const text = (message.text ?? '').trim();\n      const payload = message.quick_reply?.payload ?? '';\n      let intent = 'other';\n      if (payload.startsWith('BOOK_')) intent = 'book';\n      else if (text.toUpperCase().includes(keyword)) intent = 'spin';\n      results.push({ json: { sender_id: event.sender.id, text, payload, intent } });\n    }\n  }\n}\nreturn results;"
      },
